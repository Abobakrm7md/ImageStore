{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ImageStore": "Server=localhost,1433;Database=ImageStore;User ID=sa;Password=P@ssw0rd;Persist Security Info=True;Pooling=False;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=True;Connection Timeout=30;"
  },
  "Database": {
    "Provider": "SqlServer",
    "ApplyMigrationsOnStartup": false
  },
  "Storage": {
    "RootPath": "storage/uploads"
  },
  "StorageMaintenance": {
    "Enabled": true,
    "IntervalMinutes": 60,
    "StagingFileMaxAgeMinutes": 60,
    "ScanForOrphanedFiles": true,
    "DeleteOrphanedFiles": false,
    "OrphanedFileMinAgeMinutes": 1440
  },
  "ImageUpload": {
    "MaxFileSizeBytes": 10485760,
    "MaxFilesPerRequest": 10,
    "MaxImagePixels": 100000000,
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".webp" ],
    "AllowedContentTypes": [ "image/jpeg", "image/png", "image/webp" ]
  },
  "AuthCookies": {
    "SameSite": "Strict",
    "SecurePolicy": "Always",
    "ExpireHours": 8
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "Authentication": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "Swagger": {
    "Enabled": false
  },
  "ForwardedHeaders": {
    "Enabled": false,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "DataProtection": {
    "KeysPath": ""
  }
}
